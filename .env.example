# Required
ANTHROPIC_API_KEY=sk-ant-...
CORALOGIX_API_KEY=cxtp_...

# Coralogix OTLP (us2 validated for this lab)
OTEL_EXPORTER_OTLP_ENDPOINT=https://ingress.us2.coralogix.com:443
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=otelc-anthropic-chatbot
OTEL_RESOURCE_ATTRIBUTES=cx.application.name=otelc-lab,cx.subsystem.name=anthropic-chatbot,service.version=0.1.0

# App
LISTEN_ADDR=:8080
REDIS_ADDR=localhost:6379
DB_PATH=./data/chatbot.db
STATIC_DIR=./web
ANTHROPIC_MODEL=claude-sonnet-4-5
LOG_LEVEL=info

OTEL_EXPORTER_OTLP_HEADERS="Authorization=Bearer ${CORALOGIX_API_KEY}"
